{
  "name": "inkstone",
  "version": "0.3.3",
  "private": true,
  "description": "墨观 Inkstone — a traditional Chinese color theme for editors and terminals",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Konata9/inkstone"
  },
  "homepage": "https://github.com/Konata9/inkstone#readme",
  "bugs": {
    "url": "https://github.com/Konata9/inkstone/issues"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "validate": "tsx src/validate.ts",
    "test": "pnpm validate",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm build && open preview/index.html",
    "capture:preview": "tsx scripts/capture-preview.ts",
    "package:vscode": "pnpm build && tsx scripts/package-vscode.ts",
    "package:release": "tsx scripts/package-release.ts",
    "release": "tsx scripts/release.ts",
    "release:check": "tsx scripts/check-release.ts",
    "release:tag": "tsx scripts/release-tag.ts",
    "install:ghostty": "pnpm build && bash scripts/install-ghostty.sh",
    "install:kaku": "pnpm build && bash scripts/install-kaku.sh",
    "install:opencode": "pnpm build && bash scripts/install-opencode.sh"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.10.2",
    "luaparse": "^0.3.1",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
