{
  "name": "inkstone",
  "displayName": "墨观 Inkstone · 中国传统色彩",
  "description": "A traditional Chinese color theme built from the 526-color zhongguose palette. Six variants: 玄墨 Xuanmo, 玄墨 Dimmed, 宣纸 Xuanzhi, 宣纸 Dimmed, 沧海 Canghai, 青瓷 Qingci.",
  "version": "0.3.1",
  "publisher": "moguan",
  "license": "MIT",
  "homepage": "https://github.com/Konata9/inkstone#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "dimmed",
    "blue theme",
    "warm",
    "cool",
    "ocean",
    "celadon",
    "chinese",
    "traditional chinese colors",
    "zhongguose",
    "ink",
    "inkstone",
    "moguan",
    "墨观",
    "玄墨",
    "宣纸",
    "沧海",
    "青瓷",
    "中国传统色",
    "国潮"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#14131a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Konata9/inkstone",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/Konata9/inkstone/issues"
  },
  "contributes": {
    "themes": [
      {
        "label": "墨观 · 玄墨 (Inkstone Xuanmo)",
        "uiTheme": "vs-dark",
        "path": "./themes/xuanmo-color-theme.json"
      },
      {
        "label": "墨观 · 玄墨 Dimmed (Inkstone Xuanmo Dimmed)",
        "uiTheme": "vs-dark",
        "path": "./themes/xuanmo-dimmed-color-theme.json"
      },
      {
        "label": "墨观 · 宣纸 (Inkstone Xuanzhi)",
        "uiTheme": "vs",
        "path": "./themes/xuanzhi-color-theme.json"
      },
      {
        "label": "墨观 · 宣纸 Dimmed (Inkstone Xuanzhi Dimmed)",
        "uiTheme": "vs",
        "path": "./themes/xuanzhi-dimmed-color-theme.json"
      },
      {
        "label": "墨观 · 沧海 (Inkstone Canghai)",
        "uiTheme": "vs-dark",
        "path": "./themes/canghai-color-theme.json"
      },
      {
        "label": "墨观 · 青瓷 (Inkstone Qingci)",
        "uiTheme": "vs",
        "path": "./themes/qingci-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies"
  }
}
